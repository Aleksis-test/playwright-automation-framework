{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "Reusable framework for automated testing with Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "keywords": [
    "framework",
    "automation",
    "testing",
    "playwright",
    "typescript"
  ],
  "author": "Aleksandra Janas",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}
